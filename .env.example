# Stripe (Sandbox locally; live keys only in Production)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_PORTAL_LOGIN_URL=

# Donations
DONATIONS_ENABLED=
NEXT_PUBLIC_SITE_URL=

# Session / CSRF (min 32 characters)
DONATION_SESSION_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# Upstash Redis (distributed rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional rate-limit overrides (defaults exist in code)
DONATION_RATE_LIMIT_SESSION_MAX=
DONATION_RATE_LIMIT_SESSION_WINDOW_SEC=
DONATION_RATE_LIMIT_IP_MAX=
DONATION_RATE_LIMIT_IP_WINDOW_SEC=
DONATION_RATE_LIMIT_EMAIL_MAX=
DONATION_RATE_LIMIT_EMAIL_WINDOW_SEC=
DONATION_RATE_LIMIT_MINT_MAX=
DONATION_RATE_LIMIT_MINT_WINDOW_SEC=

# Resend (transactional thank-you; optional locally)
# Display name is always "Comunità Islamica di Roma"; keep the verified address.
RESEND_API_KEY=
DONATION_EMAIL_FROM=

# Donation-form newsletter checkbox. Only the exact value "true" shows it.
# Keep false until CIR intentionally enables newsletter signups.
# Missing Brevo values never block donations.
# BREVO_API_KEY is server-only — never NEXT_PUBLIC_.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=3
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=
DONATION_NEWSLETTER_ENABLED=false
# Server-side DOI runtime gate. Only the exact value "true" enables Brevo calls.
DONATION_NEWSLETTER_DOI_RUNTIME_ENABLED=false
